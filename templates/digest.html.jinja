<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily News Digest — {{ generated_at }}</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    line-height: 1.5;
  }
  header { margin-bottom: 2.5rem; }
  h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }
  .date { color: #767676; font-size: 0.95rem; }
  section { margin-bottom: 2.5rem; }
  h2 {
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.4rem;
    opacity: 0.85;
  }
  article { margin: 1.25rem 0; }
  article h3 { margin: 0 0 0.25rem; font-size: 1.05rem; }
  article h3 a { text-decoration: none; color: inherit; }
  article h3 a:hover { text-decoration: underline; }
  .meta { font-size: 0.8rem; color: #767676; margin-bottom: 0.35rem; }
  article p { margin: 0; }
  .empty { color: #767676; font-style: italic; }
</style>
</head>
<body>
<header>
  <h1>Your Daily News Digest</h1>
  <div class="date">{{ generated_at }}</div>
</header>

{% for topic, articles in topics.items() %}
<section>
  <h2>{{ topic }}</h2>
  {% if articles %}
    {% for article in articles %}
    <article>
      <h3><a href="{{ article.link }}" target="_blank" rel="noopener">{{ article.title }}</a></h3>
      <div class="meta">{{ article.source }}{% if article.published %} · {{ article.published }}{% endif %}</div>
      <p>{{ summaries[article.link] }}</p>
    </article>
    {% endfor %}
  {% else %}
    <p class="empty">No matching articles today.</p>
  {% endif %}
</section>
{% endfor %}
</body>
</html>
